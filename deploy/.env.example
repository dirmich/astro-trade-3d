# AstroTrade 3D — dev 배포용 환경 변수 예시 (~/0.service/astro-trade/.env.prod)
# .env.prod로 복사한 뒤 비밀값을 채운다. 이 파일에는 실제 비밀값을 적지 않는다.

APP_NAME="AstroTrade 3D: Interplanetary Mining & Trading Odyssey"
APP_VERSION="1.0.2"
APP_ENV="production"
SUPERUSER_EMAIL="oldtv.cf@gmail.com"
SUPERUSER_INITIAL_PASSWORD="<dev 슈퍼유저 초기 비밀번호>"

BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
BACKEND_PUBLIC_URL="https://astrob.lab.highmaru.com"
# DB_CLIENT: "sqlite" | "postgres" — dev는 공용 PostgreSQL 사용
DB_CLIENT="postgres"
SQLITE_DB_PATH="./backend/data/astrotrade.sqlite"
# dev 공용 postgres 컨테이너(postgres:5432), DB astrotrade
POSTGRES_URL="postgresql://postgres:<URL-encoded 비밀번호>@postgres:5432/astrotrade"
DOCKER_POSTGRES_URL="postgresql://postgres:<URL-encoded 비밀번호>@postgres:5432/astrotrade"
JWT_SECRET="<dev JWT 비밀값>"
INITIAL_PLANET_COUNT=30
PLANET_EXPANSION_USERS_PER_PLANET=2
MARKET_TICK_INTERVAL_SECONDS=30
STARTING_CREDITS=3500

FRONTEND_PORT=3000
VITE_APP_TITLE="AstroTrade 3D: 성간 자원 채집 & 교역 시뮬레이터"
VITE_API_BASE_URL="https://astrob.lab.highmaru.com/api"
VITE_SUPERUSER_EMAIL="oldtv.cf@gmail.com"
VITE_INITIAL_PLANET_COUNT=30
VITE_PLANET_EXPANSION_USERS_PER_PLANET=2
VITE_STARFIELD_DENSITY=6000
VITE_ENABLE_PBR_ATMOSPHERE="true"

# deploy.sh DB 초기화용 (값은 공용 postgres와 동일하게)
POSTGRES_DB=astrotrade
POSTGRES_USER=postgres
