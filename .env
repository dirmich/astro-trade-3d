# ==============================================================================
# AstroTrade 3D — Shared Root Environment Configuration (.env)
# This file is shared by both `./backend` (Bun + Hono) and `./frontend` (Svelte + Three.js)
# ==============================================================================

# ------------------------------------------------------------------------------
# [공통/Docker] Shared Application & Docker Settings
# ------------------------------------------------------------------------------
APP_NAME="AstroTrade 3D: Interplanetary Mining & Trading Odyssey"
APP_VERSION="1.0.6"
APP_ENV="development"
SUPERUSER_EMAIL="oldtv.cf@gmail.com"
SUPERUSER_INITIAL_PASSWORD="AstroAdmin!2026#"

# ------------------------------------------------------------------------------
# [Backend] Bun.sh + Hono.js + SQLite / PostgreSQL Configuration
# ------------------------------------------------------------------------------
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
BACKEND_PUBLIC_URL="http://localhost:8000"
# DB_CLIENT options: "sqlite" (default initial database) | "postgres" (shared PostgreSQL)
DB_CLIENT="sqlite"
SQLITE_DB_PATH="./backend/data/astrotrade.sqlite"
POSTGRES_URL="postgresql://postgres:postgres@localhost:5432/astrotrade"
DOCKER_POSTGRES_URL="postgresql://postgres:postgres@host.docker.internal:5432/astrotrade"
JWT_SECRET="astrotrade-3d-orbital-quantum-jwt-secret-key-2026"
INITIAL_PLANET_COUNT=30
PLANET_EXPANSION_USERS_PER_PLANET=2
MARKET_TICK_INTERVAL_SECONDS=30
STARTING_CREDITS=3500

# ------------------------------------------------------------------------------
# [Frontend] Svelte + Vite + Three.js Configuration
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
VITE_APP_TITLE="AstroTrade 3D: 성간 자원 채집 & 교역 시뮬레이터"
VITE_API_BASE_URL="http://localhost:8000/api"
VITE_SUPERUSER_EMAIL="oldtv.cf@gmail.com"
VITE_INITIAL_PLANET_COUNT=30
VITE_PLANET_EXPANSION_USERS_PER_PLANET=2
VITE_STARFIELD_DENSITY=6000
VITE_ENABLE_PBR_ATMOSPHERE="true"
