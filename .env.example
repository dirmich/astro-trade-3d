# ==============================================================================
# AstroTrade 3D — Shared Root Environment Configuration Example (.env.example)
# Copy to `.env` and adjust values as needed.
# ==============================================================================

# ------------------------------------------------------------------------------
# [COMMON / Docker] Shared Application & Superuser Settings
# ------------------------------------------------------------------------------
APP_NAME="AstroTrade 3D: Interplanetary Mining & Trading Odyssey"
APP_VERSION="1.0.1"
APP_ENV="development"
SUPERUSER_EMAIL="oldtv.cf@gmail.com"
SUPERUSER_INITIAL_PASSWORD="<CHANGE_ME_SUPERUSER_PASSWORD>"

# ------------------------------------------------------------------------------
# [BACKEND] Bun.sh + Hono.js + SQLite / PostgreSQL Configuration
# ------------------------------------------------------------------------------
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=4000
BACKEND_PUBLIC_URL="http://localhost:4000"
# DB_CLIENT options: "sqlite" (default initial database) | "postgres" (PostgreSQL production)
DB_CLIENT="sqlite"
SQLITE_DB_PATH="./backend/data/astrotrade.sqlite"
POSTGRES_URL="postgresql://postgres:<PASSWORD>@localhost:5432/astrotrade"
JWT_SECRET="<CHANGE_ME_JWT_SECRET>"
GOOGLE_CLIENT_ID="<OPTIONAL_GOOGLE_OAUTH_CLIENT_ID>"
GOOGLE_CLIENT_SECRET="<OPTIONAL_GOOGLE_OAUTH_CLIENT_SECRET>"
INITIAL_PLANET_COUNT=30
PLANET_EXPANSION_USERS_PER_PLANET=2
MARKET_TICK_INTERVAL_SECONDS=30
STARTING_CREDITS=3500

# ------------------------------------------------------------------------------
# [FRONTEND] Svelte + Vite + Three.js Configuration
# ------------------------------------------------------------------------------
FRONTEND_PORT=5173
VITE_APP_TITLE="AstroTrade 3D: 성간 자원 채집 & 교역 시뮬레이터"
VITE_API_BASE_URL="http://localhost:4000/api"
VITE_SUPERUSER_EMAIL="oldtv.cf@gmail.com"
VITE_INITIAL_PLANET_COUNT=30
VITE_PLANET_EXPANSION_USERS_PER_PLANET=2
VITE_STARFIELD_DENSITY=6000
VITE_ENABLE_PBR_ATMOSPHERE="true"
